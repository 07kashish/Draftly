{
  "manifest_version": 3,
  "name": "Draftly AI Reply",
  "version": "0.1.1",
  "description": "Generate AI reply drafts inside Gmail using the Draftly backend.",
  "permissions": [
    "identity",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.googleapis.com/*",
    "http://localhost:8080/*"
  ],
  "oauth2": {
    "client_id": "692496901995-hbu4sflifjuuuvit220t9lo94tnlm35v.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.compose"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Draftly",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
